<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Gantt View Definition -->
    <record id="view_gantt_chart" model="ir.ui.view">
        <field name="name">project.task.gantt</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <gantt string="Tasks Gantt Chart"/>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ADD GANTT TO ALL TASK ACTIONS IN ODOO PROJECT MODULE -->
    <!-- ============================================================ -->

    <!-- Main: All Tasks action (Tasks menu) -->
    <record id="project.action_view_all_task" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,form,calendar,pivot,graph,activity,gantt</field>
    </record>

    <!-- Project-specific task view (when clicking into a project) -->
    <record id="project.action_view_task" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,form,calendar,pivot,graph,activity,gantt</field>
    </record>

    <!-- My Tasks action (personal task view - the one from your screenshot) -->
    <record id="project.action_view_my_task" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,form,calendar,pivot,graph,activity,gantt</field>
    </record>

    <!-- ============================================================ -->
    <!-- LINK GANTT VIEW TO THE ACTIONS -->
    <!-- ============================================================ -->

    <!-- Link gantt view to All Tasks action -->
    <record id="action_view_gantt_all_task" model="ir.actions.act_window.view">
        <field name="sequence">80</field>
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="view_gantt_chart"/>
        <field name="act_window_id" ref="project.action_view_all_task"/>
    </record>

    <!-- Link gantt view to Project Task action -->
    <record id="action_view_gantt_task" model="ir.actions.act_window.view">
        <field name="sequence">80</field>
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="view_gantt_chart"/>
        <field name="act_window_id" ref="project.action_view_task"/>
    </record>

    <!-- Link gantt view to My Tasks action -->
    <record id="action_view_gantt_my_task" model="ir.actions.act_window.view">
        <field name="sequence">80</field>
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="view_gantt_chart"/>
        <field name="act_window_id" ref="project.action_view_my_task"/>
    </record>

</odoo>
